# Copy to .env (gitignored) and fill in. Never commit real keys.

DATABASE_URL="file:./dev.db"

# Where uploaded original files are stored. Originals are never modified.
SOURCE_STORAGE_DIR="./data/sources"

# Gemini: transcribes Chinese speech and translates to English in one step.
# The free tier may use content to improve Google's products. Do not send
# student-identifying material on the free tier. Verify current terms first.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI: analysis and content generation (used in a later task).
# Analysis runs on the cheap model first; the fallback is used only when the
# cheap model's output fails parsing or validation.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_ANALYSIS_FALLBACK_MODEL="gpt-4.1"
